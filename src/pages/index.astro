---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Jorge L. Vargas Lara M.S.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <Header />

    <main class="home-page">

      <section class="hero">
        <div class="hero-text">
          <p class="eyebrow">Water Resources • Modeling • CFD</p>

          <h1 class="floating-name">Jorge L. Vargas Lara</h1>

          <p class="intro">
            I am a Water Resources Engineer focused on computational modeling,
            groundwater systems, and pore-scale flow processes. My work combines
            physics-based simulation with data-driven analysis to better understand
            environmental systems.
          </p>

          <div class="hero-tags">
            <span>OpenFOAM</span>
            <span>MODFLOW</span>
            <span>Python</span>
            <span>QGIS</span>
          </div>
        </div>

        <!-- HERO PROFILE IMAGE -->
        <div class="profile-wrap">
          <img
            src="/images/cover.png"
            alt="Portrait of Jorge L. Vargas Lara"
            class="profile-image"
          />
        </div>
      </section>

      <section class="featured-grid">

        <a href="/posts/post-5" class="card">
          <div class="card-visual">
            <img
              src="/images/Glow_Flow_April13_sub.png"
              alt="Biofilm research preview"
              class="card-image"
            />
            <div class="card-label">Biofilm</div>
          </div>

          <h2>Biofilm Research</h2>

          <p class="card-text">
            Pore-scale simulations and image-based modeling to study biofilm growth
            and its impact on flow and transport in porous systems.
          </p>

          <p class="card-tags">OpenFOAM • Groundwater • Transport</p>

          <span class="card-link-text">View project →</span>
        </a>

        <a href="/posts/modflow" class="card">
          <div class="card-visual">
            <img
              src="/images/modflow_colton/colton_1.png"
              alt="Groundwater modeling preview"
              class="card-image"
            />
            <div class="card-label">Groundwater</div>
          </div>

          <h2>Groundwater Modeling</h2>

          <p class="card-text">
            MODFLOW-based hydrogeologic modeling and regional analysis to evaluate
            groundwater systems and support water resource planning.
          </p>

          <p class="card-tags">MODFLOW • hydrogeology • water resources</p>

          <span class="card-link-text">View project →</span>
        </a>

        <a href="/posts/davids_engineering" class="card">
          <div class="card-visual">
            <img
              src="/images/davids_engineering/davids_01.jpg"
              alt="Field Work at Davids Engineering"
              class="card-image"
            />
            <div class="card-label">Fieldwork</div>
          </div>

          <h2>Davids Engineering</h2>

          <p class="card-text">
            Field data collection, soil moisture and salinity analysis, and applied
            water resources support work.
          </p>

          <p class="card-tags">Data Analysis • Data Collection • SGMA Reports</p>

          <span class="card-link-text">View project →</span>
        </a>

      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #111827;
  }

  :global(body) {
    min-height: 100vh;
    min-height: 100dvh;
  }

  :global(html.dark),
  :global(html.dark body) {
    background: #0d0950;
    color: white;
  }

  .home-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 2rem 4rem;
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.9fr);
    gap: 1.2rem;
    align-items: center;
  }

  .hero-text {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #475569;
  }

  :global(html.dark) .eyebrow {
    color: #cbd5e1;
  }

  .floating-name {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.95;
  }

  .intro {
    margin: 0;
    max-width: 65ch;
    font-size: 0.98rem;
    line-height: 1.45;
    color: #334155;
  }

  :global(html.dark) .intro {
    color: #e2e8f0;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }

  .hero-tags span {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #dbeafe;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e3a8a;
  }

  :global(html.dark) .hero-tags span {
    background: rgba(255, 255, 255, 0.1);
    color: #dbeafe;
  }

  /* HERO PROFILE IMAGE */
  .profile-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.5rem;
  }

  .profile-image {
    width: min(320px, 78vw);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 6px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.18);
    background: #cbd5e1;
  }

  :global(html.dark) .profile-image {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }

  /* FEATURED GRID */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: start;
  }

  .card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    padding: 0.8rem;
    background: white;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    /* align-self: start; */
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.10);
    border-color: #93c5fd;
  }

  :global(html.dark) .card {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .card-visual {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 0.8rem;
    overflow: hidden;
    background: #e2e8f0;
    margin-bottom: 0.75rem;
  }

  :global(html.dark) .card-visual {
    background: rgba(255, 255, 255, 0.08);
  }

  .card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.28s ease, opacity 0.28s ease;
    opacity: 0.94;
  }

  .card:hover .card-image {
    transform: scale(1.12);
    opacity: 1;
  }

  .card-label {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.82rem;
    color: white;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(4px);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .card:hover .card-label {
    transform: translateY(4px);
    opacity: 0;
  }

  .card h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    line-height: 1.15;
  }

  .card-text {
    margin: 0 0 0.55rem;
    font-size: 0.88rem;
    line-height: 1.35;
    color: #475569;
  }

  :global(html.dark) .card-text {
    color: #dbeafe;
  }

  .card-tags {
    margin: 0 0 0.7rem;
    font-size: 0.8rem;
    color: #64748b;
  }

  :global(html.dark) .card-tags {
    color: #cbd5e1;
  }

  .card-link-text {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563eb;
  }

  :global(html.dark) .card-link-text {
    color: #93c5fd;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

@media (max-width: 700px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .home-page {
    padding: 0.85rem 1rem 1.5rem;
    gap: 1.5rem;
    align-content: start;
  }

  .featured-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .card {
    /* height: auto; */
    min-height: 0;
  }

  .card:hover {
    transform: none;
  }

  .profile-image {
    width: min(260px, 72vw);
  }

  .card-visual {
    aspect-ratio: 16 / 9;
  }
}
</style>