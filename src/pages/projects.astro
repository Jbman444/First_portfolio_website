---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = Object.values(
  import.meta.glob('./posts/*.{md,mdx}', { eager: true })
);

const pageTitle = "Notable Projects";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <Header />

    <main class="projects-page">
      <!-- PAGE INTRO -->
      <section class="hero">
        <div class="hero-text">
          <p class="eyebrow">Projects</p>
          <h1 class="floating-name">{pageTitle}</h1>
          <p class="intro">
            A selection of modeling, simulation, visualization, and environmental
            analysis work from my portfolio.
          </p>
        </div>
      </section>

      <!-- PROJECT GRID -->
      <section class="featured-grid">
        {allPosts.map((post: any) => (
          <article class="card">
            <a class="card-link" href={post.url}>

              <!-- IMAGE AREA -->
              <div class="visual">
                {post.frontmatter.image?.url ? (
                  <>
                    <img
                      src={post.frontmatter.image.url}
                      alt={post.frontmatter.image.alt ?? post.frontmatter.title}
                      class="project-image light-image"
                    />

                    {post.frontmatter.imageDark?.url && (
                      <img
                        src={post.frontmatter.imageDark.url}
                        alt={post.frontmatter.imageDark.alt ?? post.frontmatter.title}
                        class="project-image dark-image"
                      />
                    )}
                  </>
                ) : (
                  <span>Project</span>
                )}
              </div>

              <!-- TEXT AREA -->
              <div class="card-content">
                <h2>{post.frontmatter.title}</h2>

                {post.frontmatter.description && (
                  <p class="card-text">{post.frontmatter.description}</p>
                )}
              </div>
            </a>
          </article>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #111827;
  }

  :global(body) {
    min-height: 100vh;
    min-height: 100dvh;
  }

  :global(html.dark),
  :global(html.dark body) {
    background: #0d0950;
    color: white;
  }

  .projects-page {
    min-height: 0;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.9rem 1.25rem 5rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  /* PAGE INTRO */
  .hero {
    display: block;
  }

  .hero-text {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #475569;
  }

  :global(html.dark) .eyebrow {
    color: #cbd5e1;
  }

  .floating-name {
    margin: 0 0 0.35rem;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 0.95;
  }

  .intro {
    margin: 0;
    max-width: 62ch;
    font-size: 0.95rem;
    line-height: 1.4;
    color: #334155;
  }

  :global(html.dark) .intro {
    color: #e2e8f0;
  }

  /* GRID OF PROJECTS */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  /* EACH PROJECT CARD */
  .card {
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    background: white;
    overflow: hidden;
  }

  :global(html.dark) .card {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .card-link {
    height: 100%;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  /* LARGE IMAGE AREA */
  /* .visual {
    position: relative;
    width: 100%;
    min-height: 320px;
    background: #e2e8f0;
    overflow: hidden;
  } */
    .visual {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #e2e8f0;
    overflow: hidden;
  }

  :global(html.dark) .visual {
    background: rgba(255, 255, 255, 0.12);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* dark mode image switching */
  .dark-image {
    display: none;
  }

  :global(html.dark) .light-image {
    display: none;
  }

  :global(html.dark) .dark-image {
    display: block;
  }

  /* TEXT BLOCK BELOW IMAGE */
  .card-content {
    padding: 0.9rem 1rem 1rem;
    display: grid;
    gap: 0.45rem;
  }

  .card h2 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.15;
  }

  .card-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #475569;
  }

  :global(html.dark) .card-text {
    color: #dbeafe;
  }

  @media (max-width: 900px) {
    .projects-page {
      width: 100%;
      padding: 0.9rem 1rem 5.5rem;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .visual {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 500px) {
    .projects-page {
      padding: 0.75rem 0.75rem 5.5rem;
    }

    .floating-name {
      font-size: clamp(1.8rem, 9vw, 2.4rem);
    }

    .visual {
      aspect-ratio: 4 / 3;
    }

    .card-content {
      padding: 0.8rem;
    }
  }
</style>