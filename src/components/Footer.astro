---
import Social from './Social.astro';
---

<div class="contact-menu">
  <button class="contact-toggle" aria-expanded="false">
    Contact
  </button>

  <div class="contact-links">
    <Social platform="LinkedIn" username="jorgelvlara" />
    <Social platform="GitHub" username="Jbman444" />
    <Social platform="Resume" username="/resume.pdf" />
    <Social platform="Email" username="jorgeblue5210@gmail.com" />
  </div>
</div>

<script>
  const contactMenu = document.querySelector('.contact-menu');
  const contactToggle = document.querySelector('.contact-toggle');

  if (contactMenu && contactToggle) {
    contactToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      contactMenu.classList.toggle('open');

      const isOpen = contactMenu.classList.contains('open');
      contactToggle.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;

      if (!contactMenu.contains(target)) {
        contactMenu.classList.remove('open');
        contactToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>


<style>
  .contact-menu {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .contact-toggle {
    display: none;
  }

  .contact-links {
    display: flex;
    gap: 0.6rem;
  }

  .contact-links a {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: white !important;
    color: #111827 !important;
    border-color: #cbd5e1 !important;
    padding: 0.75rem 1.1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 700px) {
    .contact-menu {
      right: 0.75rem;
      bottom: 0.75rem;
      flex-direction: column-reverse;
      align-items: flex-end;
    }

    .contact-toggle {
      display: inline-flex;
      border: 1px solid #f97316;
      border-radius: 999px;
      background: #f97316;
      color: white;
      padding: 0.75rem 1.1rem;
      font-weight: 700;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
      align-items: center;
      justify-content: center;
    }

    .contact-links {
      display: none;
      flex-direction: column;
      gap: 0.6rem;
    }

    .contact-menu.open .contact-links {
      display: flex;
    }


    .contact-toggle,
    .contact-links a {
      padding: 0.7rem 1rem;
      font-size: 0.95rem;
    }
  }
</style>